{
  "name": "@quota-flow/db-supabase",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "migrate:schema": "node scripts/supabase-migrate.mjs schema",
    "migrate:data": "node scripts/supabase-migrate.mjs data",
    "migrate:storage": "node scripts/supabase-migrate.mjs storage",
    "migrate:all": "node scripts/supabase-migrate.mjs all"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "pg": "^8.23.0"
  }
}
