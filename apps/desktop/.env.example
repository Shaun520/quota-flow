# 复制为 .env 并填入你的 Supabase 项目配置（anon key 是公开的，可安全内置）
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 参考图上传（图生视频）已切到 GitHub 公开仓库 + jsDelivr CDN（免费、0 带宽费）。
# 配置同样可写在 userData/gh-images.json（打包后的应用请用文件方式）：
#   { "token": "github_pat_...", "owner": "你的用户名", "repo": "公开仓库名", "branch": "可选", "cdnBase": "选填" }
# token 需到 GitHub Settings > Developer settings > Personal access tokens 生成，勾选 repo 写权限；
# 仓库必须设为 Public（jsDelivr/raw 只服务公开内容），参考图会公开可见。
# 生成后的 url 形如：https://cdn.jsdelivr.net/gh/<owner>/<repo>@<branch>/qf-images/<name>.png
GH_TOKEN=YOUR-GITHUB-PERSONAL-ACCESS-TOKEN
GH_OWNER=YOUR-GITHUB-USERNAME
GH_REPO=qf-images-host
GH_BRANCH=
GH_CDN_BASE=