# Supabase 迁移配置。复制此文件为 .env.migrate 并填入真实密钥（.env.migrate 已 gitignore）。
# Service Role 密钥：项目 Settings → API → Project API keys → service_role（旧库/新库各一个）。
SRC_SUPABASE_URL=https://OLD-PROJECT.supabase.co
SRC_SERVICE_ROLE=OLD-service-role-key
DST_SUPABASE_URL=https://NEW-PROJECT.supabase.co
DST_SERVICE_ROLE=NEW-service-role-key

# 可选：schema 合并文件输出路径（默认 scripts/schema_combined.sql）
# MIGRATE_SCHEMA_OUT=./schema_combined.sql