{
  "name": "@quota-flow/desktop",
  "version": "0.2.5",
  "description": "Quota-Flow 桌面端（Electron + Vite + React）",
  "author": "Quota-Flow",
  "homepage": "https://github.com/Shaun520/quota-flow",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "release": "pnpm run build && electron-builder --win",
    "release:publish": "git fetch --tags origin && pnpm run build && electron-builder --win --publish always",
    "release:win": "pnpm run build && electron-builder --win --publish always",
    "release:mac": "pnpm run build && electron-builder --mac --publish always",
    "release:linux": "pnpm run build && electron-builder --linux --publish always",
    "release:dir": "pnpm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.5.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@quota-flow/auth": "workspace:^",
    "@quota-flow/db-supabase": "workspace:^",
    "@quota-flow/providers": "workspace:^",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.21.3"
  }
}
