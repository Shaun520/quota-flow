# 运行时数据目录（可选）：默认 ~/.quota-flow，账本/任务日志/cookie 凭据都放这里
# QUOTA_FLOW_DATA_DIR=/absolute/path/to/data-dir

# CLI 写库凭据（可选：不配置则 generate 只写本地 jobs.jsonl）
# SUPABASE_URL / SUPABASE_ANON_KEY 与 apps/desktop/.env 里的 VITE_* 值相同
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 桌面端注册的账号（邮箱 + 登录密码）
QUOTA_FLOW_EMAIL=you@example.com
QUOTA_FLOW_PASSWORD=your-password
